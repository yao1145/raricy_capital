# capital1 / capital2 资金服务运行环境（示例）
#
# 用法：复制到 /etc/raricy-funds/funds.env，填入真实凭据后 chmod 0600 并
# chown root:raricy-funds。该文件**不进 Git、不进镜像、不进迁移包**；迁移时通过
# 独立安全通道另送（见 docs/DEPLOYMENT.md §10）。
#
# 这里刻意只放变量名与占位符：任何真实口令、令牌、Cookie 都不应出现在仓库里。
# 所有变量都保留 FUNDS_ 前缀。

# 各基金的站点账号（每只基金一个独立账号；登录时校验两个账号 ID 不同）。
# 服务启动时按 FUNDS_<基金ID大写>_USERNAME / _PASSWORD 读取；用户名以 changeme
# 开头的会被忽略（占位符不会被当成真实账号）。这两个变量优先于凭据库里存的账号。
FUNDS_CAPITAL1_USERNAME=changeme-account-1
FUNDS_CAPITAL1_PASSWORD=changeme-password-1
FUNDS_CAPITAL2_USERNAME=changeme-account-2
FUNDS_CAPITAL2_PASSWORD=changeme-password-2

# 管理控制台访问令牌（配合同源与 Content-Type/Origin 校验，仅经 SSH 隧道使用）。
# 占位符短于 24 位，服务会以 weak_control_token 拒绝启动，直到换成真实令牌。
# 不设置时，服务首次启动会在数据目录生成 admin.token（0600），两者二选一；
# admin.token 属于独立凭据，不随迁移包或凭据库一起迁移。
FUNDS_CONTROL_TOKEN=changeme-control-token

# 可选：凭据库（credentials.enc）的解密密钥覆盖。
# 默认使用数据目录里的 credential.key 文件；容器化部署等无法保留该文件时，才用本
# 变量注入同一把 Fernet 密钥（base64）。credentials.enc 与 credential.key 必须成对
# 保管，两者都**不在**迁移包内。
# FUNDS_CREDENTIAL_KEY=changeme-fernet-key
